# ===================================================================
# CampusDocs - Project Root Environment Configuration Template
# ===================================================================

# MongoDB Atlas Database URI (Set on Render)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority

# Google Cloud OAuth 2.0 Credentials (Set on Render)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend Application Origin URL (Set on Render to your Vercel URL, e.g. https://campusdocs.vercel.app)
FRONTEND_URL=https://campusdocs.vercel.app

# Cross-Site Cookie Settings (Required for Vercel + Render cross-domain over HTTPS)
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
